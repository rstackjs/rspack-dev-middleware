{
  "name": "@rspack/dev-middleware",
  "version": "2.0.3",
  "description": "A development middleware for Rspack",
  "keywords": [
    "rspack",
    "middleware",
    "development"
  ],
  "homepage": "https://github.com/rstackjs/rspack-dev-middleware",
  "bugs": "https://github.com/rstackjs/rspack-dev-middleware/issues",
  "repository": "rstackjs/rspack-dev-middleware",
  "license": "MIT",
  "author": "Tobias Koppers @sokra",
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "rs lib && rs fmt \"types/**/*.ts\"",
    "bump": "pnpx bumpp",
    "check": "rs check --type-check && pnpm run lint:spelling",
    "dev": "rs lib -w",
    "format": "rs fmt",
    "lint": "rs lint",
    "lint:spelling": "cspell --cache --no-must-find-files --quiet \"**/*.*\"",
    "prepare": "rs hooks",
    "test": "rs test",
    "test:watch": "rs test -w"
  },
  "devDependencies": {
    "@hapi/hapi": "^21.4.10",
    "@hono/node-server": "^2.1.1",
    "@rspack/core": "2.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/on-finished": "^2.3.5",
    "@types/range-parser": "^1.2.7",
    "connect-next": "^4.0.3",
    "cspell": "^10.2.0",
    "deepmerge": "^4.3.1",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "finalhandler": "^2.1.1",
    "hono": "^4.13.5",
    "koa": "^3.2.1",
    "memfs": "^4.68.2",
    "mrmime": "^2.0.1",
    "on-finished": "^2.4.1",
    "range-parser": "^1.3.0",
    "router": "^2.2.0",
    "rstack": "^0.7.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@rspack/core": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
